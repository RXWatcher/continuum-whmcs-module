{
  "name": "continuum/whmcs-module",
  "description": "WHMCS Provisioning Module for Continuum",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "^8.0",
    "guzzlehttp/guzzle": "^7.0",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.7"
  },
  "autoload": {
    "psr-4": {
      "Continuum\\WhmcsModule\\": "lib/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Continuum\\WhmcsModule\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs lib/ tests/",
    "package": [
      "@composer install --no-dev --optimize-autoloader",
      "mkdir -p dist",
      "tar --exclude='./.git' --exclude='./tests' --exclude='./.gitignore' --exclude='./phpunit.xml.dist' --exclude='./phpcs.xml.dist' --exclude='./.phpunit.result.cache' --exclude='./dist' -czf dist/continuum-whmcs-module-$(git describe --tags --always 2>/dev/null || echo dev).tar.gz ."
    ]
  }
}
